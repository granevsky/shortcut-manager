{
  "name": "shortcut-manager",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.5",
  "publisher": "Granevsky",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/granevsky/shortcut-manager"
  },
  "bugs": {
    "url": "https://github.com/granevsky/shortcut-manager/issues"
  },
  "engines": {
    "vscode": "^1.80.0",
    "pnpm": "^10.5.2"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "shortcut",
    "configurator",
    "workspace",
    "quick actions",
    "windows",
    "linux",
    "macos",
    "desktop",
    "generator",
    "script runner"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shortcut-manager.generateShortcut",
        "title": "%command.generateShortcut.title%"
      }
    ],
    "configuration": {
      "title": "Shortcut Manager",
      "properties": {
        "shortcut-manager.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.en%",
            "%config.language.enum.ru%"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "shortcut-manager.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun"
          ],
          "default": "auto",
          "description": "%config.packageManager.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^8.57.1",
    "typescript": "^5.1.3"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}